<Window x:Class="AirDropDesktop.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="隔空投送" Width="375" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14" Foreground="{DynamicResource Ink}"
        KeyDown="HandleKeyDown" Closing="HideOnClose">
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="17" Padding="20">
        <StackPanel>
            <Grid Margin="0,0,0,19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Viewbox Width="33" Height="33" HorizontalAlignment="Left">
                    <Canvas Width="64" Height="64">
                        <Path Stroke="#1685EA" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 16,55 A 28,28 0 1 1 48,55 M 21,49 A 21,21 0 1 1 43,49 M 25,43 A 14,14 0 1 1 39,43 M 28,37 A 7,7 0 1 1 36,37" />
                        <Ellipse Fill="#1685EA" Width="5" Height="5" Canvas.Left="29.5" Canvas.Top="29.5" />
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="隔空投送" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="ComputerLabel" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,5,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="×" ToolTip="隐藏窗口" AutomationProperties.Name="隐藏窗口"
                        FontSize="19" Width="31" Height="31" Padding="0" Click="HideClick" VerticalAlignment="Top" />
            </Grid>
            <StackPanel x:Name="TransferControls">
                <Border Padding="13,10" CornerRadius="11" Background="{DynamicResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="允许接收" FontWeight="SemiBold" />
                            <TextBlock Text="来自已配置的 iPad" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="ReceiveToggle" Grid.Column="1" Width="43" Height="25" Cursor="Hand"
                                      Click="ToggleReceive" AutomationProperties.Name="允许接收">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Track" Background="#777F8C" CornerRadius="13" Margin="0,0,1,0">
                                        <Ellipse x:Name="Thumb" Fill="White" Height="19" Width="19"
                                                 HorizontalAlignment="Left" Margin="3,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Track" Property="Background" Value="#006BD6" />
                                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Ink}" />
                                            <Setter TargetName="Track" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </Border>
                <Button x:Name="ElevateButton" Content="以管理员身份打开" Style="{StaticResource Primary}" Margin="0,10,0,0"
                        Visibility="Collapsed" Click="ElevateClick" />
                <Button x:Name="SendButton" Content="选择文件并发送…" Style="{StaticResource Primary}" Margin="0,10,0,0"
                        IsEnabled="False" Click="SendClick" />
            </StackPanel>
            <Border x:Name="DevicePicker" Visibility="Collapsed" Background="{DynamicResource Card}"
                    CornerRadius="11" Padding="13" Margin="0,11,0,0">
                <StackPanel>
                    <TextBlock x:Name="PickerTitle" Text="选择接收设备" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedFileLabel" FontSize="12" Margin="0,4,0,10"
                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <ScrollViewer MaxHeight="244" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="98" MinHeight="108" Padding="3,6" Margin="0,0,2,4"
                                            IsEnabled="{Binding CanSend}" Click="SendToDevice"
                                            AutomationProperties.Name="{Binding Name}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Tile" Background="Transparent" CornerRadius="11"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Control}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Control}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Tile" Property="Opacity" Value="0.75" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                        <Setter TargetName="Tile" Property="Background" Value="Transparent" />
                                                        <Setter TargetName="Tile" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <Grid Width="68" Height="68" HorizontalAlignment="Center">
                                                <Ellipse Width="56" Height="56">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                                                            <GradientStop Color="#70B6F0" Offset="0" />
                                                            <GradientStop Color="#3774BB" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Canvas Width="56" Height="56" IsHitTestVisible="False">
                                                    <Ellipse Fill="White" Width="17" Height="17" Canvas.Left="19.5" Canvas.Top="12" />
                                                    <Path Fill="White" Data="M 11,42 C 11,34 19,30 28,30 C 37,30 45,34 45,42 C 40,47 34,49 28,49 C 22,49 16,47 11,42 Z" />
                                                </Canvas>
                                                <Ellipse Stroke="{DynamicResource Line}" StrokeThickness="3.5" Margin="2">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ring}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <Path Stroke="#1685EA" StrokeThickness="3.5" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" Data="{Binding Ring}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Status}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" FontSize="11" Foreground="{DynamicResource Muted}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding ElementName=SpeedLabel, Path=Text}" FontSize="15"
                               Foreground="{DynamicResource AccentText}" Margin="1,2,0,3">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=SpeedLabel, Path=Text}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="PickerCloseButton" Content="取消" Click="CloseDevicePicker"
                            HorizontalAlignment="Right" Margin="0,3,0,0" FontSize="12" />
                </StackPanel>
            </Border>
            <Border x:Name="Activity" Visibility="Collapsed" Padding="12" CornerRadius="11"
                    Background="{DynamicResource Card}" Margin="0,11,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse Stroke="{DynamicResource Line}" StrokeThickness="3" Margin="1" />
                            <Path x:Name="Ring" Stroke="#1685EA" StrokeThickness="3" StrokeEndLineCap="Round" />
                            <TextBlock x:Name="ProgressLabel" Text="↓" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ActivityTitle" FontWeight="SemiBold" />
                            <TextBlock x:Name="FileLabel" FontSize="12" MaxHeight="65" Margin="0,4,0,0" />
                            <TextBlock x:Name="SpeedLabel" FontSize="15" Foreground="{DynamicResource AccentText}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                    <UniformGrid x:Name="OfferActions" Rows="1" Columns="2" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button Content="拒绝" Click="DeclineClick" Margin="0,0,4,0" />
                        <Button Content="接受" Click="AcceptClick" Style="{StaticResource Primary}" Margin="4,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusLabel" Text="正在检查驱动…" Foreground="{DynamicResource Muted}" Margin="1,13,0,0" />
            <UniformGrid Rows="1" Columns="2" Margin="0,10,0,0">
                <Button Content="打开收件文件夹" Margin="0,0,4,0" Click="OpenInbox" FontSize="12" />
                <Button x:Name="LogsButton" Content="查看最新日志" Margin="4,0,0,0" Click="OpenLog" IsEnabled="False" FontSize="12" />
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
